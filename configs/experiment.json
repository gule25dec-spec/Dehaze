    "O-HAZE / NH-HAZE mirror (Hugging Face)": "https://huggingface.co/datasets/dronefreak/NTIRE-Haze"
  },
  "preprocessing": {
    "max_side": {
      "RESIDE_SOTS_indoor": null,
      "O_HAZE": 1600,
      "NH_HAZE": null
    },
    "resize": "bicubic, same factor for hazy and GT",
    "color": "RGB, 8-bit -> [0,1]",
    "pairing": "hazy scene id -> GT (RESIDE: prefix before first '_'; O/NH-HAZE: strip _hazy/_GT)"
  },
  "inference": {
    "precision": "fp32",
    "batch_size": 1,
    "resolution": "full (after max_side)",
    "tta": false,
    "per_model": {
      "DEA-Net": "[0,1], reflect-pad to multiple of 4",
      "ConvIR": "[0,1], reflect-pad to multiple of 32, full-scale output (outputs[2]), crop back",
      "CoA": "CLIP Normalize, bicubic resize to multiple of 16, output[0], resize back",
      "BiLaLoRA": "same as CoA; Backbonecs + LoRA (r=8, alpha=16) on level3_block1/7/8"
    },
    "output": "clamp [0,1], 8-bit PNG"
  },
  "metrics": {
    "PSNR": "skimage peak_signal_noise_ratio, data_range=1, RGB",
    "SSIM": "skimage structural_similarity, gaussian_weights=True, sigma=1.5, use_sample_covariance=False, channel_axis=-1",
    "MAE": "mean |GT - pred| in [0,1]",
    "LPIPS": "lpips package, net='alex', inputs scaled to [-1,1] (full-reference, lower is better)",
    "MUSIQ": "pyiqa 'musiq' (KonIQ-10k checkpoint), 0-100, no-reference, higher is better; also computed on hazy inputs and ground-truth images",
    "efficiency": [
      "Params_M",
      "Sec_per_image (CUDA-synchronised, no I/O)"
    ]
  },
  "original_training_configs": {
    "DEA-Net": {
      "data": "RESIDE ITS / OTS",
      "crop": 256,
      "batch": 16,
      "iterations": "300 x 5000",
      "optimizer": "Adam(0.9,0.999)",
      "lr": "1e-4 -> 1e-6 cosine",
      "loss": "L1 + 0.1 contrastive (VGG-19)",
      "augmentation": "random crop, flip, rot90"
    },
    "ConvIR": {
      "variant": "ConvIR-B (base)",
      "data": "RESIDE ITS (SOTS-indoor checkpoint); O-HAZE 01-40 / NH-HAZE 01-50 train(+val) splits for the real-haze checkpoints",
      "crop": 256,
      "optimizer": "Adam(0.9,0.999)",
      "lr": "cosine-annealed to 1e-6 (see the paper / repo for per-dataset epochs)",
      "loss": "multi-scale L1 + 0.1 frequency-domain (FFT) L1",
      "augmentation": "random crop, hflip",
      "params_M": 8.63,
      "note": "per-dataset numbers taken from the official repository; checkpoints are in-domain for O-HAZE / NH-HAZE"
    },
    "CoA": {
      "data": "THaze (synthetic, paired) + unlabelled real hazy images",
      "stages": "Teacher 20x5000 -> KD student 20x5000 -> EMA adaptation 20x1000",
      "optimizer": "Adam",
      "lr": "1e-4->1e-6 cosine (teacher/KD), 1e-7->1e-8 (EMA)",
      "loss": "0.8 L1 + 0.2 SSIM + 0.05 CR; + feature alignment (KD); L1 + 0.5 CLIP (EMA)",
      "params_M": 1.69
    },
    "BiLaLoRA": {
      "data": "DEA backbone pre-trained on THaze (L1); LoRA adapted on 500 unlabelled real daytime haze images",
      "lora": "r=8, lora_alpha=16 (scale 2), top-3 layers selected by bilevel search",
      "lr": "1e-6",
      "crop": 256,
      "params_M": 3.764
    }
  },
  "hardware_software_used": {
    "gpu": "NVIDIA GeForce RTX 2080 Ti (11 GB)",
    "os": "Windows",
    "python": "3.13.7",
    "torch": "2.14.1+cu126",
    "torchvision": "0.29.1",
    "numpy": "2.5.2"
  },
