  "dataset_sources": {
    "SOTS_zip": "https://huggingface.co/datasets/desonglll/reside-SOTS/resolve/main/SOTS.zip",
    "O-HAZE/NH-HAZE mirror": "https://huggingface.co/datasets/dronefreak/NTIRE-Haze",
    "NH-HAZE_zip": "https://data.vision.ee.ethz.ch/cvl/ntire20/nh-haze/files/NH-HAZE.zip",
    "RESIDE (official page)": "https://sites.google.com/view/reside-dehaze-datasets/reside-standard",
    "O-HAZE (official page)": "https://data.vision.ee.ethz.ch/cvl/ntire18/o-haze/",
    "NH-HAZE (official page)": "https://data.vision.ee.ethz.ch/cvl/ntire20/nh-haze/",
    "SOTS mirror (Hugging Face)": "https://huggingface.co/datasets/desonglll/reside-SOTS",
    "O-HAZE / NH-HAZE mirror (Hugging Face)": "https://huggingface.co/datasets/dronefreak/NTIRE-Haze"
  },
  "preprocessing": {
    "max_side": {
      "RESIDE_SOTS_indoor": null,
      "O_HAZE": 1600,
      "NH_HAZE": null
    },
    "resize": "bicubic, same factor for hazy and GT",
    "color": "RGB, 8-bit -> [0,1]",
    "pairing": "hazy scene id -> GT (RESIDE: prefix before first '_'; O/NH-HAZE: strip _hazy/_GT)"
  },
  "inference": {
    "precision": "fp32",
    "batch_size": 1,
    "resolution": "full (after max_side)",
    "tta": false,
    "per_model": {
      "FFA-Net": "Normalize(mean=[0.64,0.6,0.58], std=[0.14,0.15,0.152])",
      "MSBDN-DFF": "[0,1], reflect-pad to multiple of 16",
      "AECR-Net": "[0,1], pad to multiple of 4; DCNv2 -> torchvision.ops.deform_conv2d",
      "DEA-Net": "[0,1], reflect-pad to multiple of 4"
    },
    "output": "clamp [0,1], 8-bit PNG"
  },
  "metrics": {
    "PSNR": "skimage peak_signal_noise_ratio, data_range=1, RGB",
    "SSIM": "skimage structural_similarity, gaussian_weights=True, sigma=1.5, use_sample_covariance=False, channel_axis=-1",
    "MAE": "mean |GT - pred| in [0,1]",
    "efficiency": [
      "Params_M",
      "Sec_per_image (CUDA-synchronised, no I/O)"
    ]
  },
  "original_training_configs": {
    "FFA-Net": {
      "data": "RESIDE ITS / OTS",
      "crop": 240,
      "batch": 2,
      "iterations": "5e5 (ITS), 1e6 (OTS)",
      "optimizer": "Adam(0.9,0.999)",
      "lr": "1e-4 cosine",
      "loss": "L1",
      "augmentation": "random crop, hflip, rot90"
    },
    "MSBDN-DFF": {
      "data": "RESIDE (HDF5 patches)",
      "crop": 256,
      "batch": 16,
      "epochs": 100,
      "optimizer": "Adam",
      "lr": "1e-4, x0.1 at epoch 50, grad clip 0.25",
      "loss": "MSE",
      "augmentation": "random crop, flip"
    },
    "AECR-Net": {
      "data": "RESIDE ITS; NH-HAZE 01-45",
      "crop": 240,
      "batch": 16,
      "iterations": "100 x 5000",
      "optimizer": "Adam(0.9,0.999)",
      "lr": "1e-4 cosine",
      "loss": "L1 + contrastive (VGG-19)",
      "augmentation": "random crop, hflip, rot90"
    },
    "DEA-Net": {
      "data": "RESIDE ITS / OTS",
      "crop": 256,
      "batch": 16,
      "iterations": "300 x 5000",
      "optimizer": "Adam(0.9,0.999)",
      "lr": "1e-4 -> 1e-6 cosine",
      "loss": "L1 + 0.1 contrastive (VGG-19)",
      "augmentation": "random crop, flip, rot90"
    }
  },
  "hardware_software_used": {
    "gpu": "NVIDIA GeForce RTX 2080 Ti (11 GB)",
    "os": "Windows",
    "python": "3.13.7",
    "torch": "2.14.1+cu126",
    "torchvision": "0.29.1",
    "numpy": "2.5.2"
  }
}